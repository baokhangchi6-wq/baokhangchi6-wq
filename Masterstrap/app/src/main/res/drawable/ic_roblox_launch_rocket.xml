<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="32dp"
    android:height="32dp"
    android:viewportWidth="32"
    android:viewportHeight="32">

  <!-- Vertical Plasma Flame Exhaust (Cyan to Blue to Orange Core) -->
  <path
      android:pathData="M13,21.5 C11.5,24 13.5,28 16,31 C18.5,28 20.5,24 19,21.5 Z">
    <aapt:attr name="android:fillColor">
      <gradient
          android:startX="16"
          android:startY="21.5"
          android:endX="16"
          android:endY="31"
          android:type="linear">
        <item android:offset="0.0" android:color="#38BDF8"/>
        <item android:offset="0.6" android:color="#0284C7"/>
        <item android:offset="1.0" android:color="#002563EB"/>
      </gradient>
    </aapt:attr>
  </path>

  <!-- Inner Hot White-Yellow Core Flame -->
  <path
      android:pathData="M14.5,21.5 C13.8,23 14.5,25.5 16,27.5 C17.5,25.5 18.2,23 17.5,21.5 Z"
      android:fillColor="#FDE047"/>

  <!-- Left Fin -->
  <path
      android:pathData="M11,13 L6,19 C5.2,19.8 5.8,21 6.8,21 L11,19 Z">
    <aapt:attr name="android:fillColor">
      <gradient
