          android:endX="26"
          android:endY="21"
          android:type="linear">
        <item android:offset="0.0" android:color="#2563EB"/>
        <item android:offset="1.0" android:color="#1E293B"/>
      </gradient>
    </aapt:attr>
  </path>

  <!-- Main Vertical Rocket Fuselage Body (High-Contrast 3D Gradient) -->
  <path
      android:pathData="M16,2 C12.5,6.5 10.5,13 11,20 L21,20 C21.5,13 19.5,6.5 16,2 Z">
    <aapt:attr name="android:fillColor">
