    <!-- FastFlag Tab Toggles & Dropdowns -->
    <string name="ff_master_switch_title">应用 Roblox 优化</string>
    <string name="ff_master_switch_desc">在保存并启动时应用所选优化。</string>
    <string name="ff_msaa_title">抗锯齿质量 (MSAA)</string>
    <string name="ff_msaa_desc">覆盖 Roblox MSAA 设置。</string>
    <string name="ff_frm_title">FRM 渲染质量覆盖</string>
    <string name="ff_frm_desc">选择固定 Roblox 渲染质量等级 (1-21)。</string>
    <string name="ff_rendering_mode_title">渲染模式</string>
    <string name="ff_rendering_mode_desc">在 Android 上优先使用 OpenGL 标志。</string>
    <string name="ff_dynamic_res_title">动态渲染分辨率</string>
    <string name="ff_dynamic_res_desc">限制内部 16:9 渲染分辨率以保证流畅度。</string>
    <string name="toggle_unlock_fps">解锁帧率限制</string>
    <string name="toggle_unlock_fps_desc">解除默认 240 FPS 限制以获得更高帧率。</string>
    <string name="ff_fps_title">帧率上限</string>
    <string name="fps_unlocker_title">帧率 (FPS)</string>
    <string name="ff_fps_desc">选择适合屏幕和设备性能的 FPS 档位。</string>
    <string name="ff_force_lowest_title">强制最低图形质量</string>
    <string name="ff_force_lowest_desc">启动时将原生图形质量固定为等级 1。</string>
    <string name="ff_reduced_motion_title">减少游戏内动态效果</string>
    <string name="ff_reduced_motion_desc">使用原生 ReducedMotion 设置减少动态效果。</string>
    <string name="ff_haptics_title">游戏内触觉震动</string>
    <string name="ff_haptics_desc">控制原生 HapticStrength 设置。</string>
    <string name="ff_fps_boost_title">一键图形加速</string>
    <string name="ff_fps_boost_desc">降低抗锯齿和特效，优先保证帧率。</string>
    <string name="ff_low_poly_title">降低 3D 模型精细度</string>
    <string name="ff_low_poly_desc">对远处 3D 模型使用简化版本。</string>
    <string name="ff_low_texture_title">降低贴图负载</string>
    <string name="ff_low_texture_desc">跳过超高分辨率贴图以节省 RAM/VRAM。</string>
    <string name="ff_android_mesh_title">优化 3D 模型内存</string>
    <string name="ff_android_mesh_desc">自动平衡 Android 设备的 3D 模型内存。</string>
    <string name="ff_mesh_preload_title">预加载 3D 模型</string>
    <string name="ff_mesh_preload_desc">提前加载 3D 模型以减少物体延迟出现。</string>
    <string name="ff_optimize_parts_title">优化 3D 物体路径</string>
    <string name="ff_optimize_parts_desc">针对多物体场景启用优化处理路径。</string>
    <string name="ff_disable_shadows_title">降低阴影负载</string>
    <string name="ff_disable_shadows_desc">调整阴影渲染以减轻 GPU 负担。</string>
    <string name="ff_disable_postfx_title">减少后期视觉特效</string>
    <string name="ff_disable_postfx_desc">关闭泛光、景深等特效以降低 GPU 占用。</string>
    <string name="ff_disable_grass_title">移除地面草丛</string>
    <string name="ff_disable_grass_desc">将草丛渲染距离设为零以提升帧率。</string>
    <string name="ff_skygray_title">灰色天空 (SkyGray)</string>
    <string name="ff_skygray_desc">用简约灰色背景替换普通天空。</string>
    <string name="ff_display_fps_title">显示 FPS 计数器</string>
    <string name="ff_display_fps_desc">启用 Roblox 内置帧率显示。</string>
    <string name="ff_disable_gui_blur_title">移除菜单背景模糊</string>
    <string name="ff_disable_gui_blur_desc">移除菜单背后的模糊背景以提高响应速度。</string>

    <!-- FF Settings Tab Toggles -->
    <string name="ffs_automatic_drs_title">稳定帧率</string>
    <string name="ffs_automatic_drs_desc">GPU 过载时自动降低渲染分辨率。</string>
    <string name="ffs_animation_lod_title">简化远处动作动画</string>
    <string name="ffs_animation_lod_desc">简化远处角色的骨骼动画以降低 CPU 负载。</string>
    <string name="ffs_android_vsync_title">平滑垂直同步</string>
    <string name="ffs_android_vsync_desc">使渲染帧与屏幕刷新同步以减少画面撕裂。</string>
    <string name="ffs_drs_basic_title">自适应图形控制</string>
    <string name="ffs_drs_basic_desc">允许根据设备性能动态调节分辨率。</string>
    <string name="ffs_drs_gpu_time_title">响应 GPU 负载</string>
    <string name="ffs_drs_gpu_time_desc">根据实际 GPU 帧时间精准调控画面。</string>
    <string name="ffs_batch_net_title">加速游戏资源加载</string>
    <string name="ffs_batch_net_desc">合并网络资源请求以加快加载速度。</string>
    <string name="ffs_desync_title">调整移动同步频率</string>
    <string name="ffs_desync_desc">调节移动与物理数据的网络发送频率。</string>
    <string name="ffs_power_mgr_title">减少后台耗电</string>
    <string name="ffs_power_mgr_desc">在后台运行时适配 Android 电源管理。</string>
    <string name="ffs_bg_session_title">可靠恢复游戏会话</string>
    <string name="ffs_bg_session_desc">从后台切回时帮助正确恢复会话连接。</string>
    <string name="ffs_unified_mesh_title">统一模型内存优化</string>
    <string name="ffs_unified_mesh_desc">优化 3D 模型内存占用。</string>
    <string name="ffs_anim_cache_title">动画缓存加速</string>
    <string name="ffs_anim_cache_desc">缓存动画数据避免重复解码。</string>

